{
  "name": "@revrebel/cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "check": "npm run check --workspace @revrebel/ip-sync-worker",
    "dev:ip-sync": "npm exec --workspace @revrebel/ip-sync-worker -- wrangler dev",
    "deploy:ip-sync": "npm run deploy --workspace @revrebel/ip-sync-worker"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true,
    "fsevents@2.3.3": false
  }
}
