# Copy to apps/ip-sync-worker/.env; never commit your real .env.
# Deployment reads this file automatically. No manual wrangler secret put needed.
DOMAIN="revrebel.io"
CLOUDFLARE_API_TOKEN="REPLACE_WITH_SCOPED_CLOUDFLARE_TOKEN"
CLOUDFLARE_ACCOUNT_ID="REPLACE_WITH_32_CHARACTER_ACCOUNT_ID"
CLOUDFLARE_ZONE_ID="REPLACE_WITH_32_CHARACTER_ZONE_ID"
# Optional: defaults to the existing list ID defined in wrangler.jsonc
# CLOUDFLARE_LIST_ID="REPLACE_WITH_32_CHARACTER_LIST_ID"

# Commas separate entries; braces are optional. Bare IPv4 becomes /32.
LOCALIP="{192.0.2.10,192.0.2.11,192.0.2.10}"
# Keep true for verification; set false to enable the publisher.
DRY_RUN="true"
