# Copy to .env in this same directory (next to wrangler.jsonc).
# Comma-separated trusted IPv4/IPv6 addresses, with optional CIDR.
# Duplicates are removed. Curly braces are supported inside the quoted value.
# Replace these documentation-only addresses with your real trusted IPs.
LOCALIP="{192.0.2.10,192.0.2.11,192.0.2.10}"

# Optional local development override (defaults to true in wrangler.jsonc)
DRY_RUN="true"
